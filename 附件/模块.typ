// cetz 绘图模块:集中定义全部绘图数据、配色、图例与绘图函数
// 内容文件 #import 本模块后直接调用绘图函数,不再各自 import cetz
#import "@preview/cetz:0.4.0": canvas
#import "@preview/cetz-plot:0.1.2": plot, chart


// 按栏宽等比缩放:图宽超出栏宽时缩到栏宽
#let 适配栏宽(图) = layout(尺寸 => {
  let 限宽 = 尺寸.width
  let 实宽 = measure(图).width
  if 实宽 > 限宽 { scale(图, 限宽 / 实宽 * 100%) } else { 图 }
})


// ========== 主行星 · 大气 ==========
// 解析模型:分层扩散平衡 + 干绝热递减率 Γ = g/c_p
// 成分由重力下的扩散平衡给出 x_i(h) ∝ x_i0·exp(−∫ M_i g /(R T) dh)
// 温度分四段:对流层(Γ=g/c_p 积分)、等温层、平流层(升温)、中间层(降温)
// 密度取理想气体 ρ = P·M̄/(R T),声速 a = √(γ R T / M̄)
// 温度与成分互相耦合(Γ 依赖成分,扩散积分依赖温度),对流层段用 ODE 积分求解

#let 重力 = 20.0
#let 气体常数 = 8.314462618
#let 海平面气压 = 1.013e5
#let 等温温 = 216.65
#let 平流层顶温 = 232.65
#let 中间层降率 = 2.5e-3

// 物种:(名, 摩尔质量 kg/mol, 自由度 f, 海平面体积比, 色);c_p,i = (f/2)·R/M
#let 大气物种 = (
  (名: "He", 质量: 0.004003, 自由度: 5, 初比: 0.20, 色: rgb("#F58518")),
  (名: "O2", 质量: 0.032000, 自由度: 7, 初比: 0.20, 色: rgb("#4C78A8")),
  (名: "Xe", 质量: 0.131290, 自由度: 5, 初比: 0.5995, 色: rgb("#BAB0AC")),
  (名: "N2", 质量: 0.028013, 自由度: 7, 初比: 0.0005, 色: rgb("#54A24B")),
)
#let 物种数 = 大气物种.len()

// 区域参数:海平面温度、等温层顶、平流层顶、平流层升温率、配色
#let 赤道参数 = (海平面温: 300.0, 等温顶: 17.2e3, 平流层顶: 24.0e3, 升率: 2.3529e-3, 色: rgb("#C62828"))
#let 极点参数 = (海平面温: 240.0, 等温顶: 8.0e3, 平流层顶: 22.4e3, 升率: 1.1111e-3, 色: rgb("#1565C0"))

// 由扩散指数 E_i 得体积比
#let 体积比(E) = {
  let w = range(物种数).map(i => 大气物种.at(i).初比 * calc.exp(-E.at(i)))
  let 总 = w.sum()
  w.map(v => v / 总)
}
// 质量加权定压比热 J/(kg·K)
#let 定压比热(比) = {
  let m = range(物种数).map(i => 比.at(i) * 大气物种.at(i).质量)
  let 总 = m.sum()
  range(物种数).map(i => m.at(i) / 总 * (大气物种.at(i).自由度 / 2) * 气体常数 / 大气物种.at(i).质量).sum()
}
// 平均摩尔质量 kg/mol
#let 平均摩尔质量(比) = range(物种数).map(i => 比.at(i) * 大气物种.at(i).质量).sum()

// 对流层 ODE:dT/dh = −g/c_p, dE_i/dh = M_i g /(R T);从海平面积分到 h
#let 对流层步长 = 5.0
#let 对流层积分(区, h) = {
  let n = calc.ceil(h / 对流层步长)
  if n <= 0 { return (T: 区.海平面温, E: (0.0,) * 物种数) }
  let dh = h / n
  range(n).fold((T: 区.海平面温, E: (0.0,) * 物种数), (状态, _) => {
    let cp = 定压比热(体积比(状态.E))
    let T新 = 状态.T - 重力 / cp * dh
    let Tm = 0.5 * (状态.T + T新)
    (T: T新, E: range(物种数).map(i => 状态.E.at(i) + 大气物种.at(i).质量 * 重力 / (气体常数 * Tm) * dh))
  })
}

// 对流层顶:积分到 T 首次降到等温温
#let 求对流层顶(区) = {
  let 末 = range(4000).fold(
    (T: 区.海平面温, E: (0.0,) * 物种数, h: 0.0, 停: false),
    (状态, _) => {
      if 状态.停 { 状态 } else {
        let cp = 定压比热(体积比(状态.E))
        let T新 = 状态.T - 重力 / cp * 对流层步长
        let Tm = 0.5 * (状态.T + T新)
        (T: T新, E: range(物种数).map(i => 状态.E.at(i) + 大气物种.at(i).质量 * 重力 / (气体常数 * Tm) * 对流层步长), h: 状态.h + 对流层步长, 停: T新 <= 等温温)
      }
    })
  (h: 末.h, E: 对流层积分(区, 末.h).E)
}

// 温度:h(m) → K
#let 大气温度(区, 顶, h) = {
  if h <= 顶.h { 对流层积分(区, h).T }
  else if h <= 区.等温顶 { 等温温 }
  else if h <= 区.平流层顶 { 等温温 + 区.升率 * (h - 区.等温顶) }
  else { 平流层顶温 - 中间层降率 * (h - 区.平流层顶) }
}

// 对流层顶以上的扩散积分 Ψ = ∫ g /(R T) dh'
#let 扩散积分(区, 顶, h) = {
  let 积 = 0.0
  let 上 = calc.min(h, 区.等温顶)
  if 上 > 顶.h { 积 += 重力 / 气体常数 * (上 - 顶.h) / 等温温 }
  if h > 区.等温顶 {
    let T2 = 等温温 + 区.升率 * (calc.min(h, 区.平流层顶) - 区.等温顶)
    积 += 重力 / (气体常数 * 区.升率) * calc.ln(T2 / 等温温)
  }
  if h > 区.平流层顶 {
    let T3 = 平流层顶温 - 中间层降率 * (h - 区.平流层顶)
    积 += 重力 / (气体常数 * 中间层降率) * calc.ln(平流层顶温 / T3)
  }
  积
}

// 扩散指数 E_i(h) = ∫ M_i g /(R T) dh'
#let 扩散指数(区, 顶, h) = {
  if h <= 顶.h { 对流层积分(区, h).E }
  else {
    let Ψ = 扩散积分(区, 顶, h)
    range(物种数).map(i => 顶.E.at(i) + 大气物种.at(i).质量 * Ψ)
  }
}
#let 组分比(区, 顶, h) = 体积比(扩散指数(区, 顶, h))

// 密度 kg/m³
#let 大气密度(区, 顶, h) = {
  let E = 扩散指数(区, 顶, h)
  let 比 = 体积比(E)
  let P = range(物种数).map(i => 大气物种.at(i).初比 * 海平面气压 * calc.exp(-E.at(i))).sum()
  P * 平均摩尔质量(比) / (气体常数 * 大气温度(区, 顶, h))
}

// 声速 m/s
#let 大气声速(区, 顶, h) = {
  let 比 = 组分比(区, 顶, h)
  let Mbar = 平均摩尔质量(比)
  let cp = 定压比热(比)
  let γ = cp / (cp - 气体常数 / Mbar)
  calc.sqrt(γ * 气体常数 * 大气温度(区, 顶, h) / Mbar)
}

// 各区域对流层顶(常量)
#let 赤道顶 = 求对流层顶(赤道参数)
#let 极点顶 = 求对流层顶(极点参数)

// 大气成分(海平面体积比)与饼图配色
#let 大气成分 = (
  (名: [$"He"$], 占比: 20.0, 色: rgb("#F58518")),
  (名: [$"O"_2$], 占比: 20.0, 色: rgb("#4C78A8")),
  (名: [$"Xe"$], 占比: 59.95, 色: rgb("#BAB0AC")),
  (名: [$"N"_2$], 占比: 0.05, 色: rgb("#54A24B")),
)

// 大气成分饼图(cetz-plot 内置)
#let 大气成分饼图 = canvas({
  chart.piechart(
    大气成分,
    value-key: "占比",
    label-key: "名",
    slice-style: 大气成分.map(项 => 项.色),
    radius: 1.2,
    gap: 0deg,
    outer-label: (content: none),
  )
})

// 曲线说明:替代图内图例,与曲线同色
#let 曲线图例 = text(size: .85em)[
  #text(fill: 赤道参数.色)[━ 赤道]　#text(fill: 极点参数.色)[━ 极点]
  #h(1em)#text(fill: rgb("#B0B0B0"))[┄ 对流层顶]　#text(fill: rgb("#B0B0B0"))[┄ 平流层顶]
]

// 剖面图:取(区, 顶, h) 返回横轴值,随高度变化;超出栏宽时等比缩放
#let 剖面图(取, 轴参数) = 适配栏宽(canvas({
  plot.plot(
    size: (7.5, 4.6),
    axis-style: "scientific",
    ..轴参数,
    y-min: 0, y-max: 30, y-tick-step: 5, y-label: [高度 (km)], y-grid: true,
    {
      plot.add(h => (取(赤道参数, 赤道顶, h * 1000), h), domain: (0, 30), samples: 300,
        mark: none, style: (stroke: 赤道参数.色 + 1.6pt))
      plot.add(h => (取(极点参数, 极点顶, h * 1000), h), domain: (0, 30), samples: 300,
        mark: none, style: (stroke: 极点参数.色 + 1.6pt))
      let 分界 = (paint: rgb("#B0B0B0"), thickness: .7pt, dash: "dashed")
      plot.add-hline(赤道顶.h / 1000, axes: ("x", "y"), style: (stroke: 分界))
      plot.add-hline(极点顶.h / 1000, axes: ("x", "y"), style: (stroke: 分界))
      plot.add-hline(24.0, axes: ("x", "y"), style: (stroke: 分界))
      plot.add-hline(22.4, axes: ("x", "y"), style: (stroke: 分界))
    }
  )
}))

// 组分剖面图:He/Xe/O2 体积比随高度(赤道)
#let 组分色 = (He: rgb("#F58518"), O2: rgb("#4C78A8"), Xe: rgb("#8C6D31"))
#let 组分图例 = text(size: .85em)[
  #text(fill: 组分色.He)[━ He]　#text(fill: 组分色.O2)[━ $"O"_2$]　#text(fill: 组分色.Xe)[━ Xe]
]
#let 组分剖面图 = 适配栏宽(canvas({
  plot.plot(
    size: (7.5, 4.6),
    axis-style: "scientific",
    x-min: 0, x-max: 100, x-tick-step: 20, x-label: [体积比 (%)], x-grid: true,
    y-min: 0, y-max: 30, y-tick-step: 5, y-label: [高度 (km)], y-grid: true,
    {
      plot.add(h => (组分比(赤道参数, 赤道顶, h * 1000).at(0) * 100, h), domain: (0, 30), samples: 300,
        mark: none, style: (stroke: 组分色.He + 1.6pt))
      plot.add(h => (组分比(赤道参数, 赤道顶, h * 1000).at(1) * 100, h), domain: (0, 30), samples: 300,
        mark: none, style: (stroke: 组分色.O2 + 1.6pt))
      plot.add(h => (组分比(赤道参数, 赤道顶, h * 1000).at(2) * 100, h), domain: (0, 30), samples: 300,
        mark: none, style: (stroke: 组分色.Xe + 1.6pt))
    }
  )
}))


