// 从剖面表取第 列 在高度 h(m) 的值,线性插值
#let 大气取值(表, 列, h) = {
  if h <= 表.first().at(0) { 表.first().at(列) }
  else if h >= 表.last().at(0) { 表.last().at(列) }
  else {
    let i = range(表.len() - 1).filter(i => 表.at(i).at(0) <= h and h <= 表.at(i + 1).at(0)).first()
    let (h0, h1) = (表.at(i).at(0), 表.at(i + 1).at(0))
    let t = (h - h0) / (h1 - h0)
    表.at(i).at(列) * (1 - t) + 表.at(i + 1).at(列) * t
  }
}
#let 大气温度(h, 表) = 大气取值(表, 1, h)
#let 大气密度(h, 表) = 大气取值(表, 2, h)
#let 大气声速(h, 表) = 大气取值(表, 3, h)

// 曲线说明:替代图内图例,与曲线同色
#let 曲线图例 = text(size: .85em)[
  #text(fill: 赤道色)[━ 赤道]　#text(fill: 极点色)[━ 极点]
  #h(1em)#text(fill: rgb("#B0B0B0"))[┄ 对流层顶]　#text(fill: rgb("#B0B0B0"))[┄ 平流层顶]
]

// 剖面图:第 列 随高度变化;超出栏宽时等比缩放
#let 剖面图(列, 轴参数) = 适配栏宽(canvas({
  plot.plot(
    size: (7.5, 4.6),
    axis-style: "scientific",
    ..轴参数,
    y-min: 0, y-max: 30, y-tick-step: 5, y-label: [高度 (km)], y-grid: true,
    {
      plot.add(h => (大气取值(赤道大气, 列, h * 1000), h), domain: (0, 30), samples: 200,
        mark: none, style: (stroke: 赤道色 + 1.6pt))
      plot.add(h => (大气取值(极点大气, 列, h * 1000), h), domain: (0, 30), samples: 200,
        mark: none, style: (stroke: 极点色 + 1.6pt))
      let 分界 = (paint: rgb("#B0B0B0"), thickness: .7pt, dash: "dashed")
      plot.add-hline(1.43, axes: ("x", "y"), style: (stroke: 分界))
      plot.add-hline(0.32, axes: ("x", "y"), style: (stroke: 分界))
      plot.add-hline(24.0, axes: ("x", "y"), style: (stroke: 分界))
      plot.add-hline(22.4, axes: ("x", "y"), style: (stroke: 分界))
    }
  )
}))

