// cetz 绘图模块:集中定义全部绘图数据、配色、图例与绘图函数
// 内容文件 #import 本模块后直接调用绘图函数,不再各自 import cetz
#import "@preview/cetz:0.4.0": canvas
#import "@preview/cetz-plot:0.1.2": plot, chart


// 按栏宽等比缩放:图宽超出栏宽时缩到栏宽
#let 适配栏宽(图) = layout(尺寸 => {
  let 限宽 = 尺寸.width
  let 实宽 = measure(图).width
  if 实宽 > 限宽 { scale(图, 限宽 / 实宽 * 100%) } else { 图 }
})


// ========== 主行星 · 大气 ==========

// 大气成分(体积比)与饼图配色
#let 大气成分 = (
  (名: [$"N"_2$], 占比: 78.1, 色: rgb("#4C78A8")),
  (名: [$"O"_2$], 占比: 20.95, 色: rgb("#F58518")),
  (名: [其它], 占比: 0.95, 色: rgb("#BAB0AC")),
)

// 大气成分饼图(cetz-plot 内置)
#let 大气成分饼图 = canvas({
  chart.piechart(
    大气成分,
    value-key: "占比",
    label-key: "名",
    slice-style: 大气成分.map(项 => 项.色),
    radius: 1.2,
    gap: 0deg,
    outer-label: (content: none),
  )
})

// 大气解析式:温度 K / 密度 $"kg/m"^3$ 随高度 h(m) 变化
// 温/密 为海平面值,顶为对流层顶,等温顶为等温层顶,平流层顶为温度峰值处
#let 赤道色 = rgb("#C62828")
#let 极点色 = rgb("#1565C0")
#let 大气常量 = (
  gMR: 0.06976,
  对流层率: 6.5e-3,
  对流层顶温: 216.65,
  等温标高: 3.11e3,
  密指数: 9.733,
  降率: 2.5e-3,
)
#let 赤道大气 = (
  温: 300, 密: 1.18, 顶: 1.2823e4,
  等温顶: 1.72e4, 平流层顶: 2.4e4, 平流层顶温: 232.65, 升率: 2.3529e-3,
)
#let 极点大气 = (
  温: 240, 密: 1.47, 顶: 3.5923e3,
  等温顶: 8.0e3, 平流层顶: 2.24e4, 平流层顶温: 232.65, 升率: 1.1111e-3,
)

#let 大气温度(h, a) = {
  if h <= a.顶 { a.温 - 大气常量.对流层率 * h }
  else if h <= a.等温顶 { 大气常量.对流层顶温 }
  else if h <= a.平流层顶 { 大气常量.对流层顶温 + a.升率 * (h - a.等温顶) }
  else { a.平流层顶温 - 大气常量.降率 * (h - a.平流层顶) }
}

#let 大气密度(h, a) = {
  let 顶密度 = a.密 * calc.pow(大气常量.对流层顶温 / a.温, 大气常量.密指数)
  let 等温顶密度 = 顶密度 * calc.exp(-(a.等温顶 - a.顶) / 大气常量.等温标高)
  let 平流层顶密度 = 等温顶密度 * calc.pow(
    a.平流层顶温 / 大气常量.对流层顶温, -大气常量.gMR / a.升率 - 1)
  if h <= a.顶 {
    a.密 * calc.pow(大气温度(h, a) / a.温, 大气常量.密指数)
  } else if h <= a.等温顶 {
    顶密度 * calc.exp(-(h - a.顶) / 大气常量.等温标高)
  } else if h <= a.平流层顶 {
    等温顶密度 * calc.pow(大气温度(h, a) / 大气常量.对流层顶温, -大气常量.gMR / a.升率 - 1)
  } else {
    平流层顶密度 * calc.pow(大气温度(h, a) / a.平流层顶温, 大气常量.gMR / 大气常量.降率 - 1)
  }
}

// 曲线说明:替代图内图例,与曲线同色
#let 曲线图例 = text(size: .85em)[
  #text(fill: 赤道色)[━ 赤道]　#text(fill: 极点色)[━ 极点]
  #h(1em)#text(fill: rgb("#B0B0B0"))[┄ 对流层顶]　#text(fill: rgb("#B0B0B0"))[┄ 平流层顶]
]

// 剖面图:按解析式绘制;超出栏宽时等比缩放
#let 剖面图(取值, 轴参数) = 适配栏宽(canvas({
  plot.plot(
    size: (7.5, 4.6),
    axis-style: "scientific",
    ..轴参数,
    y-min: 0, y-max: 30, y-tick-step: 5, y-label: [高度 (km)], y-grid: true,
    {
      plot.add(h => (取值(h * 1000, 赤道大气), h), domain: (0, 30), samples: 200,
        mark: none, style: (stroke: 赤道色 + 1.6pt))
      plot.add(h => (取值(h * 1000, 极点大气), h), domain: (0, 30), samples: 200,
        mark: none, style: (stroke: 极点色 + 1.6pt))
      let 分界 = (paint: rgb("#B0B0B0"), thickness: .7pt, dash: "dashed")
      plot.add-hline(12.82, axes: ("x", "y"), style: (stroke: 分界))
      plot.add-hline(3.59, axes: ("x", "y"), style: (stroke: 分界))
      plot.add-hline(24.0, axes: ("x", "y"), style: (stroke: 分界))
      plot.add-hline(22.4, axes: ("x", "y"), style: (stroke: 分界))
    }
  )
}))


